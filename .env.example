# Copy to .env and fill in. .env is gitignored and read only by server.js —
# never by the browser, never committed.

# Claude — the brain. Used by /api/plans/scan and the chat proxy.
ANTHROPIC_API_KEY=

# Groq — fallback when Claude is unavailable.
GROQ_API_KEY=

# ElevenLabs — voice.
ELEVENLABS_API_KEY=

# Collectors (task 5). Add as each one is wired up.
OURA_TOKEN=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
